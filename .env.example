# =============================================================================
# RIGHTNOW — Environment Variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / Runtime
# -----------------------------------------------------------------------------
# Node environment: development | test | production
NODE_ENV=development
# Port the Fastify server listens on
PORT=3000
# Host the server binds to (0.0.0.0 inside containers, 127.0.0.1 for local-only)
HOST=0.0.0.0
# Public URL of the API (used for webhooks, redirects, CORS)
API_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins (the web client)
CLIENT_ORIGIN=http://localhost:5173
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Demo mode: log OTPs instead of sending via Twilio, and accept 123456 for any
# phone. For local development only — NEVER enable in production.
DEMO_MODE=true

# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS
# -----------------------------------------------------------------------------
# Full connection string (preferred). PostGIS extension must be enabled.
DATABASE_URL=postgresql://rightnow:rightnow@localhost:5432/rightnow
# Individual parts (used by docker-compose and as a fallback)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rightnow
POSTGRES_USER=rightnow
POSTGRES_PASSWORD=rightnow
# Max connections in the pg pool
POSTGRES_POOL_MAX=20
# Set to true to require SSL (managed databases in production)
POSTGRES_SSL=false

# -----------------------------------------------------------------------------
# Redis (presence, pub/sub for Socket.io, rate limiting, geo sets)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty if no password is configured
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Authentication / JWT
# -----------------------------------------------------------------------------
# Secret used to sign access tokens. Use a long random string (>= 32 chars).
JWT_SECRET=change-me-to-a-long-random-secret-string
# Access token lifetime (e.g. 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# Twilio (SMS / OTP verification)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Phone number messages are sent from, OR a Verify service SID
TWILIO_FROM_NUMBER=+15555550123
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid

# -----------------------------------------------------------------------------
# Stripe (Boost purchases, RIGHTNOW+ subscriptions)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# Signing secret for verifying Stripe webhook events
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret

# -----------------------------------------------------------------------------
# OpenAI (AI bio scorer, chat safety, demand push copy)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key
# Default model for AI features
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Cloudinary (profile photo / media uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# -----------------------------------------------------------------------------
# Google Places API (venue suggestions for meetups)
# -----------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# -----------------------------------------------------------------------------
# Mapbox (client-side map rendering) — exposed to the browser via Vite
# -----------------------------------------------------------------------------
# NOTE: client-side vars live in client/.env and MUST be prefixed with VITE_
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
VITE_API_URL=http://localhost:3000
VITE_SOCKET_URL=http://localhost:3000
